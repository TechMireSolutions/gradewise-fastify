# Backend API
NEXT_PUBLIC_API_URL=http://localhost:5005

# reCAPTCHA (optional — dummy-key bypasses in dev)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=dummy-key

# Firebase (needed for Google OAuth)
# NEXT_PUBLIC_FIREBASE_PROJECT_ID must match backend FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=grade-wise-ai-v2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
